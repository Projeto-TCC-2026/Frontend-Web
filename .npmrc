# O Angular 17 (@angular-devkit/build-angular) declara tailwindcss como
# peerOptional ^2 || ^3, mas o projeto usa Tailwind 4 via @tailwindcss/postcss.
# O Tailwind 4 nao entra mais na build pipeline do Angular, e sim pelo PostCSS
# (postcss.config.json), entao o conflito e apenas declarativo.
# Sem isso, npm ci falha com ERESOLVE em ambientes limpos como o CI.
legacy-peer-deps=true
